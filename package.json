{
  "name": "rmf-field-guide",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run kit",
    "preview": "astro preview",
    "controls": "node scripts/import-oscal.mjs",
    "og-image": "node scripts/make-og-image.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:search": "node scripts/check-search.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "lint": "markdownlint-cli2",
    "test": "node --test \"scripts/test/*.test.mjs\"",
    "astro": "astro",
    "kit": "node --disable-warning=ExperimentalWarning scripts/build-templates.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/starlight": "^0.42.4",
    "@fontsource/public-sans": "^5.2.5",
    "@fontsource/source-serif-4": "^5.2.5",
    "astro": "^7.2.10",
    "sharp": "^0.35.3",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.23.3",
    "pa11y-ci": "^4.1.1"
  }
}
